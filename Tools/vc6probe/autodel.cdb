$$ autodel.cdb - run at entry of c2 FUN_1070179c (unlink and free a tuple, ecx = the tuple) once $t18 = 1, i.e.
$$ after the `x = x + rest` pass FUN_1072626e has started. Prints the caller, the source line, the opcode and,
$$ for a destination operand of kind 1, its symbol id.
r $t1 = @ecx
r $t2 = poi(@$t1+1c)
r $t3 = 0
.if (@$t2 > 0x10000) { .if (by(@$t2+8) == 1) { r $t3 = poi(poi(@$t2+14)+1c) } }
.printf "D ret=%x line=%d op=%x dest=%x\n", poi(@esp), wo(0x107ac360), poi(@$t1+4), @$t3
