$$ autoadd.cdb - run at entry of c2 FUN_10729327 (address-mode matcher, edx = the tuple it starts from).
$$ Prints the tuple's opcode and source line, then each operand (+0x18 list, linked by +0): kind (+8), symbol id
$$ (operand +0x14 -> +0x1c) and, for a temp with a defining tuple (symbol +0x14), that tuple's opcode and operands.
r $t1 = @edx
.printf "A t=%x line=%d op=%x list=%x ops=", @$t1, poi(0x107ac360) & 0xffff, poi(@$t1+4), poi(@$t1+18)
r $t2 = poi(@$t1+18)
r $t4 = 0
.while ((@$t2 != 0) & (@$t4 < 6)) { r $t4 = @$t4 + 1; r $t5 = poi(@$t2+14); r $t6 = 0; r $t7 = 0; .if (by(@$t2+8) == 1) { r $t6 = poi(@$t5+14); r $t7 = poi(@$t5+1c) }; .if (by(@$t2+8) == 7) { r $t7 = poi(@$t2+18) }; .printf "[@%x k=%d id=%x", @$t2, by(@$t2+8), @$t7; .if (@$t6 > 0x10000) { .printf " def=%x(", poi(@$t6+4); r $t8 = poi(@$t6+18); r $t9 = 0; .while ((@$t8 != 0) & (@$t9 < 6)) { r $t9 = @$t9 + 1; r $t10 = 0; .if (by(@$t8+8) == 1) { r $t10 = poi(poi(@$t8+14)+1c) }; .if (by(@$t8+8) == 7) { r $t10 = poi(@$t8+18) }; .printf "%d/%x ", by(@$t8+8), @$t10; .if (by(@$t8+8) == 0) { .break }; r $t8 = poi(@$t8) }; .printf ")" }; .printf "] "; .if (by(@$t2+8) == 0) { .break }; r $t2 = poi(@$t2) }
.printf "\n"
